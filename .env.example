# Firebase Web SDK config — from Firebase Console > Project settings > General > Your apps.
# Baked into the client bundle at build time by Vite (must be prefixed VITE_).
# Set these as Netlify site environment variables for production deploys.
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
